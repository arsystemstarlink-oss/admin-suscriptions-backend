rules_version = '2';
// Solo el backend accede a Firestore, con Admin SDK, que no pasa por estas reglas.
// Ningún cliente debe leer ni escribir directamente: los usuarios existen en Firebase Auth con
// contraseña real, y cualquier permiso aquí permitiría saltarse las validaciones de la API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
