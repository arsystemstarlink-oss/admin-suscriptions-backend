PORT=3000
CORS_ORIGIN=http://localhost:5173

# Número de saltos de proxy inverso a confiar (Railway/Heroku: 1).
# Solo desactivar con 'false' si no hay proxy delante.
TRUST_PROXY=1

CRON_SCHEDULE=0 0 * * *
SCHEDULER_TIMEZONE=America/Caracas
NODE_ENV=development
FIREBASE_CREDENTIALS_PATH=./api-gestion-starlink-firebase-adminsdk-fbsvc-a7cdd010e2.json

# Mínimo 32 caracteres. En producción no uses el valor de ejemplo.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Clave secreta para crear el PRIMER admin (POST /api/auth/setup).
# Solo funciona mientras no exista ningún admin. Generar con: openssl rand -hex 32
# Los admins adicionales se crean con POST /api/auth/register (requiere JWT de admin).
SETUP_KEY=

# URL pública del backend (necesaria para validar firmas de Twilio)
BASE_URL=http://localhost:3000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# En development puedes poner false para pruebas locales.
# En production la validación de firma es siempre obligatoria.
TWILIO_WEBHOOK_VALIDATION=true
TWILIO_TEMPLATE_SUBSCRIPTION_REMINDER_3DAYS_2V=
TWILIO_TEMPLATE_SUBSCRIPTION_CUTOFF_DAY_2V=
TWILIO_TEMPLATE_SUBSCRIPTION_SUSPENDED_NOTICE_2V=
